// Bản V10: analytics chưa hỗ trợ điều kiện lọc động.
// Đối chiếu commit: e75a63f7b916d0d90c2a608d1fc8af3d4907489b. Không đổi số lượng hoặc chiều luồng.
// DFD Level 2 — Phân rã tiến trình 8.0: Thống kê và bản đồ nhiệt.
// Các luồng biên giữ NGUYÊN mã, hướng từ Level 1:
// F15 E2 -> 8.1; F16 8.5 -> E2;
// I20 D3 -> 8.2; I21 D4 -> 8.4; I22 D5 -> 8.3; I23 D1 -> 8.3.
// D1/D3/D4/D5 là các kho dữ liệu logic trên NeonDB PostgreSQL Cloud.
digraph DFD_Level_2_P8 {
  graph [label="DFD MỨC 2 — PHÂN RÃ TIẾN TRÌNH 8.0: THỐNG KÊ & BẢN ĐỒ NHIỆT\nHệ thống Tự động thuyết minh đa ngôn ngữ · Kho dữ liệu logic: NeonDB PostgreSQL Cloud",
    labelloc=t, labeljust=c, fontname="Arial", fontsize=19, fontcolor="#233247",
    bgcolor="white", pad=0.55, rankdir=LR, nodesep=1.12, ranksep=2.32,
    splines=polyline, concentrate=false, newrank=true, outputorder=edgesfirst];
  node [fontname="Arial", fontsize=11];
  edge [fontname="Arial", fontsize=9, arrowsize=0.90, penwidth=1.45, color="#64748B"];

  E2 [label="E2\nQUẢN TRỊ VIÊN", shape=box, style=filled, fillcolor="#1687C1", fontcolor="white", margin="0.24,0.19"];
  P81 [label="8.1\nTiếp nhận yêu\ncầu thống kê", shape=circle, style=filled, fillcolor="#F5A623", fontcolor="white", width=1.85, height=1.85, fixedsize=true];
  P82 [label="8.2\nTổng hợp phiên\nđang hoạt động", shape=circle, style=filled, fillcolor="#F5A623", fontcolor="white", width=1.85, height=1.85, fixedsize=true];
  P83 [label="8.3\nThống kê lượt nghe\nvà POI nổi bật", shape=circle, style=filled, fillcolor="#F5A623", fontcolor="white", width=1.85, height=1.85, fixedsize=true];
  P84 [label="8.4\nPhân tích vị trí\nvà tạo heatmap", shape=circle, style=filled, fillcolor="#F5A623", fontcolor="white", width=1.85, height=1.85, fixedsize=true];
  P85 [label="8.5\nKết xuất báo cáo\nvà phản hồi", shape=circle, style=filled, fillcolor="#F5A623", fontcolor="white", width=1.85, height=1.85, fixedsize=true];

  D3 [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD WIDTH="250" HEIGHT="4" BGCOLOR="#087E83"></TD></TR><TR><TD HEIGHT="52" BGCOLOR="#EAF9F8"><FONT FACE="Arial" COLOR="#164E50" POINT-SIZE="12">D3  |  PHIÊN THAM QUAN<BR/>user_sessions</FONT></TD></TR><TR><TD HEIGHT="4" BGCOLOR="#087E83"></TD></TR></TABLE>>];
  D4 [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD WIDTH="250" HEIGHT="4" BGCOLOR="#087E83"></TD></TR><TR><TD HEIGHT="52" BGCOLOR="#EAF9F8"><FONT FACE="Arial" COLOR="#164E50" POINT-SIZE="12">D4  |  NHẬT KÝ GPS<BR/>tracking_logs</FONT></TD></TR><TR><TD HEIGHT="4" BGCOLOR="#087E83"></TD></TR></TABLE>>];
  D5 [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD WIDTH="250" HEIGHT="4" BGCOLOR="#087E83"></TD></TR><TR><TD HEIGHT="52" BGCOLOR="#EAF9F8"><FONT FACE="Arial" COLOR="#164E50" POINT-SIZE="12">D5  |  LỊCH SỬ NGHE<BR/>play_history</FONT></TD></TR><TR><TD HEIGHT="4" BGCOLOR="#087E83"></TD></TR></TABLE>>];
  D1 [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD WIDTH="250" HEIGHT="4" BGCOLOR="#087E83"></TD></TR><TR><TD HEIGHT="52" BGCOLOR="#EAF9F8"><FONT FACE="Arial" COLOR="#164E50" POINT-SIZE="12">D1  |  ĐIỂM THAM QUAN<BR/>pois · poi_contents · categories</FONT></TD></TR><TR><TD HEIGHT="4" BGCOLOR="#087E83"></TD></TR></TABLE>>];

  {rank=same; E2;}
  {rank=same; P81;}
  {rank=same; D3; P82;}
  {rank=same; D5; D1; P83;}
  {rank=same; D4; P84;}
  {rank=same; P85;}

  // Luồng biên từ DFD mức 1: F15/F16/I20–I23.
  E2 -> P81 [label="F15 · Yêu cầu thống kê (chưa lọc động)", color="#2563A6", fontcolor="#1D4C88", penwidth=1.6, weight=5];
  P85 -> E2 [label="F16 · Thống kê, heatmap", color="#2563A6", fontcolor="#1D4C88", penwidth=1.6, constraint=false];
  D3 -> P82 [label="I20 · Phiên và trạng thái online", color="#087E83", fontcolor="#087E83", penwidth=1.5, constraint=false];
  D5 -> P83 [label="I22 · Lịch sử nghe", color="#087E83", fontcolor="#087E83", penwidth=1.5, constraint=false];
  D1 -> P83 [label="I23 · Thông tin POI", color="#087E83", fontcolor="#087E83", penwidth=1.5, constraint=false];
  D4 -> P84 [label="I21 · Nhật ký vị trí", color="#087E83", fontcolor="#087E83", penwidth=1.5, constraint=false];

  // Luồng T81–T86 nằm hoàn toàn BÊN TRONG tiến trình cha 8.0.
  P81 -> P82 [label="T81 · Yêu cầu dashboard/heatmap/online", weight=6];
  P82 -> P83 [label="T82 · Yêu cầu tổng hợp mặc định", weight=6];
  P82 -> P85 [label="T83 · Tổng số phiên / phiên online", constraint=false];
  P83 -> P84 [label="T84 · Ngữ cảnh POI và phạm vi thống kê", weight=6];
  P83 -> P85 [label="T85 · Lượt nghe, thời lượng và top POI", constraint=false];
  P84 -> P85 [label="T86 · Dữ liệu tổng hợp bản đồ nhiệt", weight=6];
}
