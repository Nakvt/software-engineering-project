// Đối chiếu commit: e75a63f7b916d0d90c2a608d1fc8af3d4907489b. Không đổi số lượng hoặc chiều luồng.
// DFD MỨC 2 — phân rã tiến trình 6.0: Quản lý POI và nội dung.
// CÁC LUỒNG BIÊN THEO DFD MỨC 1: F11, F12, F17, F18, I15, I16.
// Txx: luồng nội bộ giữa các tiến trình con, không phải API độc lập.
// Render: dot -Tpng -Gdpi=145 DFD_Level_2_P6.dot -o DFD_Level_2_P6.png
//         dot -Tsvg DFD_Level_2_P6.dot -o DFD_Level_2_P6.svg

digraph DFD_Level_2_P6 {
 graph [label="DFD MỨC 2 — PHÂN RÃ TIẾN TRÌNH 6.0: QUẢN LÝ POI & NỘI DUNG\nHệ thống Tự động thuyết minh đa ngôn ngữ · Kho logic D1 trên NeonDB PostgreSQL",
        labelloc=t,labeljust=c,fontname="Arial",fontsize=19,fontcolor="#233247",bgcolor="white",pad=0.6,
        rankdir=LR,nodesep=1.12,ranksep=2.32,splines=polyline, concentrate=false, newrank=true,outputorder=edgesfirst];
 node [fontname="Arial",fontsize=11];
 edge [fontname="Arial",fontsize=9,arrowsize=0.90,penwidth=1.45,color="#62798A"];

 E2 [label="E2\nQUẢN TRỊ VIÊN",shape=box,style=filled,fillcolor="#1687C1",fontcolor=white,margin="0.26,0.2"];
 E3 [label="E3\nGOOGLE TRANSLATE API",shape=box,style=filled,fillcolor="#1687C1",fontcolor=white,margin="0.22,0.19"];
 P61 [label="6.1\nTiếp nhận &\nkiểm tra dữ liệu",shape=circle,style=filled,fillcolor="#F5A623",fontcolor=white,width=1.78,height=1.78,fixedsize=true];
 P62 [label="6.2\nTra cứu POI\nhiện có",shape=circle,style=filled,fillcolor="#F5A623",fontcolor=white,width=1.78,height=1.78,fixedsize=true];
 P63 [label="6.3\nXử lý tạo, sửa\nhoặc xóa POI",shape=circle,style=filled,fillcolor="#F5A623",fontcolor=white,width=1.78,height=1.78,fixedsize=true];
 P64 [label="6.4\nChuẩn bị &\ndịch nội dung",shape=circle,style=filled,fillcolor="#F5A623",fontcolor=white,width=1.78,height=1.78,fixedsize=true];
 P65 [label="6.5\nLưu thay đổi &\ntrả kết quả",shape=circle,style=filled,fillcolor="#F5A623",fontcolor=white,width=1.78,height=1.78,fixedsize=true];
 D1 [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD WIDTH="250" HEIGHT="4" BGCOLOR="#087E83"></TD></TR><TR><TD HEIGHT="52" BGCOLOR="#EAF9F8"><FONT FACE="Arial" COLOR="#164E50" POINT-SIZE="12">D1  |  POI / danh mục / nội dung</FONT></TD></TR><TR><TD HEIGHT="4" BGCOLOR="#087E83"></TD></TR></TABLE>>];

 {rank=same; E2;}
 {rank=same; P61; P62;}
 {rank=same; P63;}
 {rank=same; P64;}
 {rank=same; P65; E3;}
 {rank=same; D1;}

 // Luồng biên: giữ NGUYÊN mã và chiều như tiến trình 6.0 của DFD mức 1.
 E2 -> P61 [label="F11 · Dữ liệu POI / nội dung",color="#2563A6",fontcolor="#1D4C88",penwidth=1.5,weight=8];
 P65 -> E2 [label="F12 · Danh sách / kết quả POI",color="#2563A6",fontcolor="#1D4C88",penwidth=1.5,constraint=false];
 P64 -> E3 [label="F17 · Văn bản gốc + ngôn ngữ đích",color="#2563A6",fontcolor="#1D4C88",penwidth=1.5,constraint=false];
 E3 -> P64 [label="F18 · Nội dung đã dịch",color="#2563A6",fontcolor="#1D4C88",penwidth=1.5,constraint=false];
 D1 -> P62 [label="I16 · POI / nội dung hiện có",color="#087E83",fontcolor="#087E83",penwidth=1.5,constraint=false];
 P65 -> D1 [label="I15 · Lưu / cập nhật POI, nội dung",color="#087E83",fontcolor="#087E83",penwidth=1.5,weight=5];

 // Luồng nội bộ của bản phân rã logic.
 P61 -> P62 [label="T61 · Tiêu chí tra cứu",weight=6];
 P61 -> P65 [label="T68 · Kết quả kiểm tra / lỗi đầu vào",constraint=false];
 P61 -> P63 [label="T62 · Dữ liệu hợp lệ / thao tác",weight=7];
 P62 -> P63 [label="T63 · Dữ liệu POI hiện có",weight=6];
 P62 -> P65 [label="T64 · Danh sách / chi tiết tra cứu",constraint=false];
 P63 -> P64 [label="T65 · Nội dung cần dịch",weight=6];
 P63 -> P65 [label="T66 · Thay đổi không cần dịch",constraint=false];
 P64 -> P65 [label="T67 · Nội dung đa ngôn ngữ",weight=7];
}
