// Bản V10: chưa có debounce vị trí ổn định; cooldown dựa play_history.
// Đối chiếu commit: e75a63f7b916d0d90c2a608d1fc8af3d4907489b. Không đổi số lượng hoặc chiều luồng.
// DFD mức 2 — phân rã tiến trình 3.0 GPS & Geofence của DFD mức 1.
// 3 tác nhân/tiến trình kế cận: E1, P4, P5; 2 kho: D1, D4.
// Các luồng đi qua ranh giới tiến trình 3.0: F03, F04, I03–I07.
// Cách dựng: dot -Tpng -Gdpi=145 DFD_Level_2_P3.dot -o DFD_Level_2_P3.png
//            dot -Tsvg DFD_Level_2_P3.dot -o DFD_Level_2_P3.svg

digraph DFD_Level_2_P3 {
  graph [label="DFD MỨC 2 — PHÂN RÃ TIẾN TRÌNH 3.0: GPS & GEOFENCE\nHệ thống tự động thuyết minh đa ngôn ngữ · Các kho logic thuộc NeonDB PostgreSQL", labelloc=t,
    fontname="Arial", fontsize=19, fontcolor="#22364B", bgcolor="white",
    pad=0.55, rankdir=LR, nodesep=1.12, ranksep=2.32, splines=polyline, concentrate=false, newrank=true,
    outputorder=edgesfirst];
  node [fontname="Arial", fontsize=11];
  edge [fontname="Arial", fontsize=9, arrowsize=0.90, penwidth=1.45, color="#596D7D"];
  E1 [label="E1\nKHÁCH THAM QUAN",shape=box,style=filled,fillcolor="#1687C1",fontcolor=white,margin="0.22,0.18"];
  P4 [label="4.0\nQuản lý\nphiên khách\n(kế cận)", shape=circle, style=filled, fillcolor="#E8EFF4",color="#8AA3B5",fontcolor="#334B60",width=1.63,height=1.63,fixedsize=true];
  P5 [label="5.0\nGhi nhận\nlịch sử nghe\n(kế cận)", shape=circle, style=filled, fillcolor="#E8EFF4",color="#8AA3B5",fontcolor="#334B60",width=1.63,height=1.63,fixedsize=true];
  P31 [label="3.1\nTiếp nhận\nvà chuẩn hóa\ntọa độ GPS",shape=circle,style=filled,fillcolor="#F5A623",fontcolor=white,width=1.72,height=1.72,fixedsize=true];
  P32 [label="3.2\nTra cứu\nthông số\nvùng POI",shape=circle,style=filled,fillcolor="#F5A623",fontcolor=white,width=1.72,height=1.72,fixedsize=true];
  P33 [label="3.3\nXác định\nPOI trong\nbán kính",shape=circle,style=filled,fillcolor="#F5A623",fontcolor=white,width=1.72,height=1.72,fixedsize=true];
  P34 [label="3.4\nKiểm tra\ncooldown",shape=circle,style=filled,fillcolor="#F5A623",fontcolor=white,width=1.72,height=1.72,fixedsize=true];
  P35 [label="3.5\nGhi nhận GPS\nvà phát hành\nkết quả",shape=circle,style=filled,fillcolor="#F5A623",fontcolor=white,width=1.72,height=1.72,fixedsize=true];
  D1 [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD WIDTH="250" HEIGHT="4" BGCOLOR="#087E83"></TD></TR><TR><TD HEIGHT="52" BGCOLOR="#EAF9F8"><FONT FACE="Arial" COLOR="#164E50" POINT-SIZE="12">D1 | POI / danh mục / nội dung</FONT></TD></TR><TR><TD HEIGHT="4" BGCOLOR="#087E83"></TD></TR></TABLE>>];
  D4 [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD WIDTH="250" HEIGHT="4" BGCOLOR="#087E83"></TD></TR><TR><TD HEIGHT="52" BGCOLOR="#EAF9F8"><FONT FACE="Arial" COLOR="#164E50" POINT-SIZE="12">D4 | Nhật ký GPS</FONT></TD></TR><TR><TD HEIGHT="4" BGCOLOR="#087E83"></TD></TR></TABLE>>];
  {rank=same; E1; P4;}
  {rank=same; P32; D1;}
  {rank=same; P35; D4; P5;}
  // Các cạnh tiến trình quyết định luồng bố cục chính.
  E1 -> P31 [label="F03 · Tọa độ GPS",color="#2563A6",fontcolor="#1D4C88",weight=9];
  P31 -> P32 [label="T01 · Tọa độ để tra cứu vùng",weight=7];
  P32 -> P33 [label="T02 · Danh sách POI và bán kính",weight=7];
  P33 -> P34 [label="T03 · POI ứng viên và khoảng cách",weight=7];
  P34 -> P35 [label="T04 · Kết quả kiểm tra trigger",weight=7];
  P35 -> E1 [label="F04 · POI được kích hoạt",color="#2563A6",fontcolor="#1D4C88",constraint=false];
  P31 -> P33 [label="T05 · Tọa độ đã chuẩn hóa",constraint=false];
  P31 -> P35 [label="T06 · Bản ghi tọa độ / thời điểm",constraint=false];
  P31 -> P4 [label="I07 · Hoạt động GPS/phiên",constraint=false];
  P32:s -> D1:n [xlabel="I03 · Tiêu chí tra cứu vùng POI",color="#087E83",fontcolor="#087E83",constraint=false];
  D1:n -> P32:s [xlabel="I04 · Thông số POI",color="#087E83",fontcolor="#087E83",constraint=false];
  P35 -> D4 [label="I05 · Bản ghi GPS",color="#087E83",fontcolor="#087E83",constraint=false];
  P35 -> P5 [label="I06 · Ngữ cảnh trigger (chưa phải nghe)",constraint=false];
}
